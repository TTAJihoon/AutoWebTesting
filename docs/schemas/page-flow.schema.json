{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/page-flow.schema.json",
  "title": "page-flow",
  "description": "화면 간 이동 관계. ExecutionPlan 검증과 실패 분석 보조에 사용한다. MVP에서는 강제 실행 엔진이 아니라 추적 보조 정보.",
  "type": "object",
  "required": [
    "schemaVersion",
    "flowId",
    "name",
    "startPageStateId",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "flowId": {
      "type": "string",
      "pattern": "^FLOW_[A-Z0-9_]+$",
      "description": "FLOW_{대문자영숫자언더스코어} 형식"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "startPageStateId": { "type": "string", "pattern": "^PAGE_[0-9]{3}$" },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "required": ["transitionId", "fromPageStateId", "toPageStateId", "trigger"],
      "additionalProperties": false,
      "properties": {
        "transitionId": {
          "type": "string",
          "pattern": "^TR_[0-9]{3}$"
        },
        "fromPageStateId": { "type": "string", "pattern": "^PAGE_[0-9]{3}$" },
        "toPageStateId": { "type": "string", "pattern": "^PAGE_[0-9]{3}$" },
        "trigger": {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": ["click", "fill", "selectOption", "submitForm", "clickRowAction", "goto", "press"]
            },
            "elementId": {
              "type": "string",
              "pattern": "^PAGE_[0-9]{3}\\.el_[0-9]{4}$"
            },
            "description": { "type": "string" }
          }
        },
        "expectedNavigation": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "NONE",
                "URL_CHANGE",
                "TEXT_APPEAR",
                "ELEMENT_APPEAR",
                "MODAL_OPEN",
                "MODAL_CLOSE",
                "POPUP_OPEN",
                "URL_CHANGE_OR_TEXT_APPEAR",
                "URL_CHANGE_OR_DOM_CHANGE"
              ]
            },
            "urlPattern": { "type": "string" },
            "requiredTexts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeoutMs": { "type": "integer", "minimum": 100 }
          }
        }
      }
    }
  }
}
