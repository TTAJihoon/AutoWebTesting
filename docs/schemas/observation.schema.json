{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/observation.schema.json",
  "title": "observation",
  "description": "특정 시점의 화면을 AI가 판단할 수 있도록 정리한 관찰 데이터. DOM Summary 참조 + 화면 식별 단서 + 선택적 masked screenshot.",
  "type": "object",
  "required": [
    "schemaVersion",
    "observationId",
    "explorationSessionId",
    "url",
    "title",
    "observationType",
    "domSummaryId",
    "elementRegistryId",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "observationId": { "type": "string", "pattern": "^OBS_[0-9]{3,6}$" },
    "explorationSessionId": {
      "type": "string",
      "pattern": "^EXP_[0-9]{8}_[0-9]{3}$"
    },
    "pageStateId": {
      "type": ["string", "null"],
      "description": "기존 PageState로 식별된 경우. null이면 미식별/신규 화면"
    },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "observationType": {
      "type": "string",
      "enum": [
        "TEXT_DOM_PRIMARY",
        "TEXT_DOM_WITH_IMAGE",
        "IMAGE_ASSISTED_ONLY",
        "ERROR_STATE",
        "UNKNOWN_STATE"
      ]
    },
    "pageStateGuess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    },
    "domSummaryId": { "type": "string" },
    "elementRegistryId": { "type": "string" },
    "visibleTexts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formId": { "type": "string" },
          "label": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tableId": { "type": "string" },
          "label": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": "string" },
        "originalPath": { "type": "string" },
        "sendToLlm": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "string",
              "enum": ["OPTIONAL_ON_AMBIGUITY", "FORCE_SEND", "NEVER"]
            }
          ]
        },
        "maskingApplied": { "type": "boolean" },
        "maskingRules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "passwordFields",
              "secretVariables",
              "emailLikeTexts",
              "phoneLikeTexts",
              "rrnLikeTexts",
              "tokenLikeTexts",
              "amountLikeTexts"
            ]
          }
        },
        "reason": { "type": "string" }
      }
    },
    "previousActionResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "previousActionId": { "type": "string" },
        "transitionDetected": { "type": "boolean" },
        "summary": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
