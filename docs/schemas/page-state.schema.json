{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/page-state.schema.json",
  "title": "page-state",
  "description": "테스트 자동화에서 구분해야 하는 화면 상태. URL이 같아도 모달/검색결과/일반상태 등이 다르면 별도 PageState가 된다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "pageStateId",
    "name",
    "stateType",
    "identityHints",
    "domSummaryId",
    "elementRegistryId",
    "capturedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "pageStateId": {
      "type": "string",
      "pattern": "^PAGE_[0-9]{3}$",
      "description": "PAGE_{3자리} 형식"
    },
    "name": { "type": "string", "minLength": 1, "description": "사람이 이해할 수 있는 화면 이름" },
    "description": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "urlPattern": {
      "type": "string",
      "description": "화면 식별용 URL 패턴. 동적 부분은 *로 표현"
    },
    "title": { "type": "string" },
    "stateType": {
      "type": "string",
      "enum": ["PAGE", "MODAL", "POPUP", "DIALOG", "PARTIAL"]
    },
    "parentPageStateId": {
      "type": "string",
      "pattern": "^PAGE_[0-9]{3}$",
      "description": "MODAL/DIALOG/PARTIAL일 때 부모 PageState"
    },
    "identityHints": {
      "type": "object",
      "description": "실행 중 현재 화면이 이 PageState인지 확인하기 위한 단서",
      "required": ["requiredTexts"],
      "additionalProperties": false,
      "properties": {
        "requiredTexts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "70% 이상 일치 시 매칭 인정"
        },
        "requiredElementIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optionalTexts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "domSummaryId": { "type": "string" },
    "elementRegistryId": { "type": "string" },
    "riskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "riskLevel": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "PROHIBITED"]
        },
        "riskFlags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capturedAt": { "type": "string", "format": "date-time" }
  }
}
