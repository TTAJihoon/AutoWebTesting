{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/run-result.schema.json",
  "title": "run-result",
  "description": "실행 완료 후 생성되는 결과. 실행 환경, 통계 요약, 개별 step/assertion 결과, 증적 경로를 포함한다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "projectId",
    "executionPlanId",
    "tcId",
    "startedAt",
    "endedAt",
    "environment",
    "summary",
    "stepResults"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "runId": {
      "type": "string",
      "pattern": "^RUN[-_][0-9]{8}[-_][0-9]{6}$",
      "description": "RUN-YYYYMMDD-hhmmss 형식"
    },
    "projectId": { "type": "string", "minLength": 1 },
    "executionPlanId": { "type": "string", "pattern": "^PLAN_TC_[0-9]{3}_[0-9]{3}$" },
    "tcId": { "type": "string", "pattern": "^TC_[0-9]{3}-[0-9]{3}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "required": ["environmentType", "baseUrl", "browser"],
      "additionalProperties": false,
      "properties": {
        "environmentType": {
          "type": "string",
          "enum": ["local", "dev", "staging", "production"]
        },
        "baseUrl": { "type": "string", "format": "uri" },
        "browser": {
          "type": "string",
          "enum": ["chromium", "firefox", "webkit"]
        },
        "headless": { "type": "boolean" },
        "appVersion": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalSteps", "passedSteps", "failedSteps", "executionStatus"],
      "additionalProperties": false,
      "properties": {
        "totalSteps": { "type": "integer", "minimum": 0 },
        "passedSteps": { "type": "integer", "minimum": 0 },
        "failedSteps": { "type": "integer", "minimum": 0 },
        "skippedSteps": { "type": "integer", "minimum": 0 },
        "executionStatus": {
          "type": "string",
          "enum": [
            "NOT_RUN", "RUNNING", "COMPLETED", "BLOCKED",
            "MAPPING_FAILED", "PAGE_STATE_MISMATCH", "NAVIGATION_FAILED",
            "DIALOG_UNHANDLED", "SCRIPT_FAILED", "SKIPPED_RISK",
            "MANUAL_REQUIRED", "CANCELLED"
          ]
        },
        "testResult": {
          "type": ["string", "null"],
          "enum": ["P", "F", "N/A", null]
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "stepResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/stepResult" }
    },
    "assertionResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertionResult" }
    },
    "createdDataRegistryId": { "type": ["string", "null"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "videos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "logs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "testDataSnapshotId": { "type": ["string", "null"] }
  },
  "$defs": {
    "stepResult": {
      "type": "object",
      "required": ["stepId", "status", "startedAt", "endedAt"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PASSED", "FAILED", "SKIPPED", "BLOCKED", "REVIEW_REQUIRED"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "message": { "type": "string" },
        "currentUrl": { "type": "string" },
        "pageStateId": { "type": "string" },
        "screenshotPath": { "type": "string" },
        "resolveAttempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "selectorType": { "type": "string" },
              "selector": { "type": "string" },
              "result": {
                "type": "string",
                "enum": ["FOUND", "NOT_FOUND", "MULTIPLE_MATCHES", "TIMEOUT", "ERROR"]
              }
            }
          }
        }
      }
    },
    "assertionResult": {
      "type": "object",
      "required": ["stepId", "assertion", "passed"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "string" },
        "assertion": { "type": "string" },
        "passed": { "type": "boolean" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
