{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/exploration-session.schema.json",
  "title": "exploration-session",
  "description": "한 번의 AI 탐색 작업 전체. URL/계정/시험의도 입력 → 탐색 후보 생성까지의 메타 정보와 통계를 보존한다. 실제 Observation/AiDecision/Action 기록은 별도 파일로 관리한다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "explorationSessionId",
    "projectId",
    "targetUrl",
    "goal",
    "mode",
    "llmMode",
    "environmentType",
    "status",
    "startedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "explorationSessionId": {
      "type": "string",
      "pattern": "^EXP_[0-9]{8}_[0-9]{3}$",
      "description": "EXP_YYYYMMDD_{seq} 형식"
    },
    "projectId": { "type": "string", "minLength": 1 },
    "targetUrl": { "type": "string", "format": "uri" },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "사용자가 입력한 시험 의도. 한국어"
    },
    "inputSources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featureList": { "type": "boolean" },
        "manual": { "type": "boolean" },
        "webShape": { "type": "boolean" }
      }
    },
    "mode": {
      "type": "string",
      "enum": ["AI_ASSISTED_EXPLORATION", "MANUAL_GUIDED"]
    },
    "llmMode": {
      "type": "string",
      "enum": ["GPT_WEB_IMPORT", "API_MODE", "AI_EXPLORATION", "MANUAL", "GPT_WEB_IMPORT_OR_API_ADAPTER"]
    },
    "environmentType": {
      "type": "string",
      "enum": ["local", "dev", "staging", "production"]
    },
    "riskPolicyId": { "type": "string" },
    "testDataProfileId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "COMPLETED", "CANCELLED", "FAILED", "PAUSED"]
    },
    "stopReason": {
      "type": "string",
      "enum": [
        "MAX_STEPS_REACHED",
        "MAX_PAGE_STATES_REACHED",
        "REPEATED_SCREEN",
        "ONLY_RISKY_CANDIDATES",
        "LOGIN_FAILED",
        "SESSION_EXPIRED",
        "USER_CANCELLED",
        "AI_NO_MORE_CANDIDATES",
        "FATAL_ERROR"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "default": 50 },
        "maxPageStates": { "type": "integer", "minimum": 1, "default": 20 },
        "maxSameUrlVisits": { "type": "integer", "minimum": 1, "default": 3 },
        "maxSameActionRepeats": { "type": "integer", "minimum": 1, "default": 2 },
        "allowAutoExecuteHigh": { "type": "boolean", "default": false }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visitedPageStates": { "type": "integer", "minimum": 0 },
        "candidateFeatures": { "type": "integer", "minimum": 0 },
        "candidateCrudFlows": { "type": "integer", "minimum": 0 },
        "blockedActions": { "type": "integer", "minimum": 0 },
        "reviewRequiredItems": { "type": "integer", "minimum": 0 },
        "totalActionsExecuted": { "type": "integer", "minimum": 0 },
        "totalObservations": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
