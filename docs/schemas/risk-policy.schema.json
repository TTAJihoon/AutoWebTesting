{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/risk-policy.schema.json",
  "title": "risk-policy",
  "description": "프로젝트별 리스크 정책 설정. 키워드 사전, 보정 규칙, 기본 승인 정책을 포함한다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "riskPolicyId",
    "name",
    "riskKeywords",
    "defaults"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "riskPolicyId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "riskKeywords": {
      "type": "object",
      "description": "RiskFlag별 한국어 키워드 사전. GPT가 플래그를 누락해도 앱이 탐지에 활용.",
      "additionalProperties": false,
      "properties": {
        "PAYMENT": { "type": "array", "items": { "type": "string" } },
        "DELETE_DATA": { "type": "array", "items": { "type": "string" } },
        "SEND_EXTERNAL_MESSAGE": { "type": "array", "items": { "type": "string" } },
        "SUBMIT_TO_EXTERNAL_SYSTEM": { "type": "array", "items": { "type": "string" } },
        "DOWNLOAD_SENSITIVE_DATA": { "type": "array", "items": { "type": "string" } },
        "CHANGE_PERMISSION": { "type": "array", "items": { "type": "string" } },
        "CHANGE_SECURITY_SETTING": { "type": "array", "items": { "type": "string" } },
        "PUBLIC_PUBLISH": { "type": "array", "items": { "type": "string" } },
        "IRREVERSIBLE_ACTION": { "type": "array", "items": { "type": "string" } },
        "LEGAL_OR_FINANCIAL_ACTION": { "type": "array", "items": { "type": "string" } }
      }
    },
    "elevationRules": {
      "type": "array",
      "description": "키워드 매칭 시 리스크 수준을 올리는 규칙 목록",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger"],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "to": {
            "type": "string",
            "enum": ["MEDIUM", "HIGH", "PROHIBITED"]
          },
          "trigger": {
            "type": "string",
            "enum": ["ANY_RISK_KEYWORD", "HIGH_RISK_KEYWORD", "IRREVERSIBLE_KEYWORD", "PROHIBITED_KEYWORD"]
          },
          "description": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["lowExecution", "mediumExecution", "highExecution", "prohibitedExecution"],
      "additionalProperties": false,
      "properties": {
        "lowExecution": {
          "type": "string",
          "enum": ["AUTO", "WARN_BEFORE"]
        },
        "mediumExecution": {
          "type": "string",
          "enum": ["AUTO", "WARN_BEFORE"]
        },
        "highExecution": {
          "type": "string",
          "enum": ["APPROVAL_REQUIRED", "BLOCKED"]
        },
        "prohibitedExecution": {
          "type": "string",
          "enum": ["BLOCKED"]
        },
        "defaultApprovalScope": {
          "type": "string",
          "enum": ["PER_ACTION", "PER_TC", "PER_RUN"]
        }
      }
    },
    "deletePolicy": {
      "type": "object",
      "description": "Delete 행위에 대한 특별 정책",
      "additionalProperties": false,
      "properties": {
        "onlyCreatedData": {
          "type": "boolean",
          "default": true,
          "description": "AutoWebTesting이 생성한 데이터만 삭제 허용"
        },
        "defaultRiskLevel": {
          "type": "string",
          "enum": ["HIGH", "PROHIBITED"],
          "default": "HIGH"
        }
      }
    }
  }
}
