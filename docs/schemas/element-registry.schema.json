{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autowebtesting.local/schemas/element-registry.schema.json",
  "title": "element-registry",
  "description": "앱 내부 전용. elementId를 실제 Playwright locator 후보와 연결한다. GPT에 전달하지 않는다.",
  "type": "object",
  "required": ["schemaVersion", "elementRegistryId", "pageStateId", "items", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3" },
    "elementRegistryId": { "type": "string", "pattern": "^REG_[0-9]{3}$" },
    "pageStateId": { "type": "string", "pattern": "^PAGE_[0-9]{3}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/registryItem" }
    }
  },
  "$defs": {
    "registryItem": {
      "type": "object",
      "required": ["elementId", "selectorCandidates"],
      "additionalProperties": false,
      "properties": {
        "elementId": {
          "type": "string",
          "pattern": "^PAGE_[0-9]{3}\\.el_[0-9]{4}$"
        },
        "selectorCandidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selectorCandidate" }
        },
        "stableHints": { "$ref": "#/$defs/stableHints" },
        "lastKnownBounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      }
    },
    "selectorCandidate": {
      "type": "object",
      "required": ["type", "value", "priority"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["testId", "role", "label", "placeholder", "text", "css", "xpath"]
        },
        "value": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stableHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "placeholder": { "type": ["string", "null"] },
        "nearbyText": { "type": ["string", "null"] },
        "formId": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] }
      }
    }
  }
}
